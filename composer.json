{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4.27",
        "ext-zip": "*",
        "dedoc/scramble": "^0.13.49",
        "emreyarligan/enum-concern": "dev-main",
        "filament/filament": "^5.10.3",
        "filament/spatie-laravel-media-library-plugin": "^5.10.3",
        "filament/spatie-laravel-settings-plugin": "^5.10.3",
        "guzzlehttp/guzzle": "^8.3.0",
        "laravel/framework": "^13.38.0",
        "laravel/horizon": "^5.50.1",
        "laravel/octane": "^2.22.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/socialite": "^5.31.0",
        "laravel/tinker": "^3.0.2",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "novadaemon/filament-pretty-json": "^4.2.0",
        "opcodesio/log-viewer": "^3.24.2",
        "spatie/eloquent-sortable": "^5.0.1",
        "spatie/laravel-medialibrary": "^11.23.10",
        "spatie/laravel-query-builder": "^7.3.6",
        "spatie/laravel-settings": "^3.10.0",
        "symfony/filesystem": "^8.1.9"
    },
    "require-devUNUSED": {
        "barryvdh/laravel-ide-helper": "^3.0",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^2.9",
        "laravel/breeze": "^1.29",
        "laravel/pint": "^1.16",
        "laravel/sail": "^1.30",
        "laravel/telescope": "^5.1",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^7.10",
        "pestphp/pest": "^2.34",
        "pestphp/pest-plugin-laravel": "^2.4",
        "plannr/laravel-fast-refresh-database": "^1.2",
        "spatie/laravel-ignition": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan log-viewer:publish",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
